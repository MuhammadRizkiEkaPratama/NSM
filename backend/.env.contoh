POLL_INTERVAL=10
DEVICE_SSH_USER=nsm
DEVICE_SSH_PASS=GANTI_DENGAN_NILAI_SUNGGUHAN

# DOWN threshold, in poll intervals. The old 2x (20 s of silence) logged
# 267-277 "incidents"/day on GNS3 devices, yet 99% of failure episodes ended
# within 40 s (Dynamips routers delay ICMP replies when the host CPU is busy;
# the device is not down). 5x (50 s) cut this to 5-16 incidents/day, leaving
# only genuinely long outages.
# Details: docs/design/NETWORK-STATUS.md
DOWN_THRESHOLD=5

# Backups. Keep BACKUP_DIR2 set: without it, backups exist on only one disk.
BACKUP_DIR=C:\Users\<user>\NSM\backup
BACKUP_DIR2=C:\Users\<user>\OneDrive\NSM-backup
BACKUP_KEEP=14

# LDAP directory: NSM reads people's NAME and TITLE from it. Leave empty to
# keep NSM off the directory entirely; pages then show the raw uid. Binds
# anonymously; no password is ever requested.
LDAP_URL=ldap://192.168.20.101:389
LDAP_BASIS=dc=bsp,dc=id
LDAP_INTERVAL=1800

# --- MySQL database at 192.168.56.104 ---
# Placed at Site A, on the same LAN as the poller. Pointing it at .101
# (Site B) measured 152 ms per query and 0.11 Mbit/s through GNS3 routers that
# forward in software. A database queried dozens of times per page must not
# sit across the WAN.
# Leave NSM_DB_URL empty to fall back to SQLite without code changes.
NSM_DB_HOST=192.168.56.104
NSM_DB_PORT=3306
NSM_DB_NAME=nsm
NSM_DB_USER=nsm_app
NSM_DB_PASS=GANTI_DENGAN_NILAI_SUNGGUHAN

# Admin password for .103, used ONLY by `uji_penyangga.py` to block port 3306
# temporarily and then restore it.
UJI_103_PASS=GANTI_DENGAN_NILAI_SUNGGUHAN

# Admin password for .105 (SMB file server), used ONLY by
# `injeksi_layanan.py` to stop smbd temporarily as deliberate fault
# injection. If empty, the script exits.
UJI_105_PASS=GANTI_DENGAN_NILAI_SUNGGUHAN
AUTO_BAN_AKTIF=0

# ===========================================================================
# Per-incident notifications
# ===========================================================================
# One email per outage instead of four. Follow-ups ONLY when severity RISES.
#
# OFF by default. When ON, `notifikasi.proses_antrean()` keeps working: it
# still MARKS events as done, but events covered by an incident are marked
# without an email. Otherwise the queue would grow forever, and switching
# this off later would send hundreds of emails at once.
NOTIF_PER_INSIDEN=0

# Single closing email when an incident closes. ON by default on purpose: the
# per-EVENT path this replaces already sent recovery notices, so enabling
# per-incident mode without this would silently drop notifications people
# already receive.
NOTIF_INSIDEN_PULIH=1

# ===========================================================================
# SOC agent
# ===========================================================================
# THREE switches, by design.
#
# The agent NEVER touches devices; no line in `agen_soc.py` can, and that is
# tested. It PROPOSES, and its proposals go through the SAME
# `pagar_otomasi.putuskan()` gate as the regular remediator.

# Switch 1: whether the agent runs at all.
AGEN_SOC_AKTIF=0

# Switch 2: 'usul' = log what it WOULD do, without doing it.
#           'jalan' = proposals go to the gate, and the gate decides.
#
# Unknown values (typos) fall back to 'usul'. A typo in this file must never
# become permission to act.
#
# Recommended: run 'usul' for a few weeks first and compare its proposals with
# real human decisions at `/agen-soc`. That is the only honest way to know
# whether it can be trusted.
AGEN_SOC_MODE=usul

# Switch 3: may call an external LLM API (`ANTHROPIC_API_KEY`) to narrate
# incidents.
#
# SEPARATE from switch 1 because it answers a DIFFERENT kind of question: not
# "may it analyze" but "may it SEND device names, IP addresses, and event
# sequences OUTSIDE the lab network".
#
# When off (or the key is empty), narratives are still produced from
# templates, with every sentence traceable to one evidence field.
AGEN_SOC_NARASI=0
ANTHROPIC_API_KEY=

# How often (seconds) the agent checks for new incidents.
AGEN_SOC_INTERVAL=120

# ---------------------------------------------------------------------------
# Addresses that must NEVER be blocked, and routers with an ACL path.
#
# These used to be hardcoded lab addresses; they live here so NSM can be
# deployed on other networks.
# ---------------------------------------------------------------------------

# Address of the machine running NSM. Leave EMPTY to auto-detect.
# Set it only if NSM has more than one address or detection picks the wrong
# interface. `127.0.0.1` is always included.
#
# Used to recognize NSM's own traffic so it is not read as an attack. A wrong
# value makes NSM a block candidate against itself once AUTO_BAN_AKTIF is on.
ALAMAT_NSM=

# Other addresses that must never be blocked: gateway, directory, database;
# anything whose loss takes the network down with it.
# Comma-separated. `ALAMAT_NSM` is always included automatically.
ALAMAT_DILINDUNGI=192.168.1.1,192.168.1.10

# Routers with an ACL block path, as single-line JSON. EMPTY by default on
# purpose, in the same spirit as AUTO_BAN_AKTIF: a new install inherits no
# permission to write to any router.
#
# `lokasi` MUST exactly match `Device.location` of the devices that router
# protects. Keys are device ids from the `devices` table.
#
# Example (do NOT copy as-is; the ids and ACL names belong to another lab):
# ROUTER_ACL={"9": {"acl": "DARI-LOKASI-A", "interface": "FastEthernet0/1", "contoh_host_lokasi": "192.168.20.101", "port_uji": 389, "lokasi": "Lokasi B"}}
ROUTER_ACL=

# Address of the machine running the MySQL replica. EMPTY = nothing is
# checked. Empty by default so other installs never probe a machine nobody
# asked them to.
REPLIKASI_HOST=
